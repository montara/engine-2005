def distanceTwoPoints(p1,p2):
	(x1,y1) = p1
	(x2,y2) = p2
	
	theta = y1 - y2
	dist = sin(x1) * sin(x2) + cos(x1) * cos(x2) * cos(theta)
	ac = acos(dist)
	return ac

def rotArbPoint(x,y,z, cx, cy,cz, radians, axis):
	""" Supply coordinates for a point rotated around a center point by
	the given radians along the given axis.
	
	rotArbPoint((point), (center), radians, axis)
	
	Axes:
	1 = X
	2 = Y
	3 = Z
	
	Returns the translated x, y, and z
	
	http://www.kirupa.com/developer/actionscript/trig_multiple_axis.htm
	"""
	x = x - cx
	y = y - cy
	z = z - cz
	
	newX = x
	newY = y
	newZ = z
	
	if axis == 1:
		# rotation around x axis (a.k.a. pitch)
		newY = cos(radians)*y - sin(radians)*z
		newZ = sin(radians)*y + cos(radians)*z

	if axis == 2:
		# rotation around y axis (a.k.a. yaw)
		newZ = cos(radians)*z - sin(radians)*x
		newX = sin(radians)*z + cos(radians)*x

	if axis == 3:
		# rotation around z axis (a.k.a. roll)
		newX = cos(radians)*x - sin(radians)*y
		newY = sin(radians)*x + cos(radians)*y	
		
	newX = newX + cx
	newY = newY + cy
	newZ = newZ + cz
	
	return (newX,newY,newZ)

