# create_sphere
def create_sphere(world, space, density, radius, position):
	"""Create a Sphere body and it's corresponding geom."""
	
	# Create body
	body = ode.Body(world)
	M = ode.Mass()
	M.setSphere(density, radius)
	body.setMass(M)
	body.setPosition(position)
	
	# Set parameters for drawing body
	body.shape = "sphere"
	body.radius = radius
	
	geom = ode.GeomSphere(space, radius)
	geom.setBody(body)
	
	return body

