def rot(axis,theta):
	"""Supply rotation matrix rotated by theta degrees
	along the given axis
	
	axis 1 = x
	axis 2 = y
	axis 3 = z
	"""
	#theta = theta
	rot = None
	ca = cos(theta)
	sa = sin(theta)
	if axis == 1: # if X
		rot = [
			1.0,0.0,0.0,
			0.0,ca,sa,
			0.0,-sa,ca
			]
	if axis == 2: # if Y
		rot = [
			ca,0.0,-sa,
			0.0,1.0,0.0,
			sa,0.0,ca
			]
	if axis == 3: # if Z
		rot = [
			ca,sa,0.0,
			-sa,ca,0.0,
			0.0,0.0,1
			]
	return rot

def rotx90():
	# Set the crank end rotation
	angle = pi/2 ## (90 degrees)
	ca = cos(angle)
	sa = sin(angle)

	rot90x = [
		1.0,0.0,0.0,
		0.0,ca,sa,
		0.0,-sa,ca
	]
	return rot90x

# create_box
def create_box(world, space, density, lx, ly, lz):
	"""Create a box body and its corresponding geom."""

	# Create body
	body = ode.Body(world)
	M = ode.Mass()
	M.setBox(density, lx, ly, lz)
	body.setMass(M)

	# Set parameters for drawing the body
	body.shape = "box"
	body.boxsize = (lx, ly, lz)

	# Create a box geom for collision detection
	geom = ode.GeomBox(space, lengths=body.boxsize)
	geom.setBody(body)

	return body

