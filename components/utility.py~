def circleLineIntersect(p1, p2, c, radius):
	""" Returns the point closest to p1 
	
	p1 = (point1x, point1y)
	p2 = (point2x, point2y)
	c = (centerx, centery)  
	radius = radius of circle
	"""
	(x1, y1) = p1
	(x2, y2) = p2
	(cx,cy) = c
	
	dx = x2-x1
	dy = y2-y1
	
	a = dx*dx + dy*dy
	b = 2 * (dx * (x1 - cx) + dy * (y1 - cy))
	c = (x1 - cx) * (x1 - cx) + (y1 - cy) * (y1 - cy) - (radius*radius)
	
	det = b * b - 4 * a * c
		
	if (a <= 0.0000001) or (det < 0):
		return None
	elif det == 0:
		t = -b/(2*a)
		ix1 = x1 + t * dx
		iy1 = y1 + t * dy
		return (ix1, iy1)
	else:
		t = (-b + sqrt(det)) / (2 * a)
		ix1 = x1 + t * dx
		iy1 = y1 + t * dy
		t = (-b - sqrt(det)) / (2 * a)
		ix2 = x1 + t * dx
		iy2 = y1 + t * dy
		
		distance1 = distanceTwoPoints(p1,(ix1,iy1))
		distance2 = distanceTwoPoints(p1,(ix2,iy2))		
