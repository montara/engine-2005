def rotArbAxis(point, theta, linexyz1, linexyz2):
	"""Rotate the point, by theta, around a line
	"""
	q = [0,0,0]
	r = [0,0,0]
	x = 0
	y = 1
	z = 2
	point = list(point)
	linexyz1 = list(linexyz1)
	linexyz2 = list(linexyz2)
	r[x] = linexyz2[x] - linexyz1[x]
	r[y] = linexyz2[y] - linexyz1[y]
	r[z] = linexyz2[z] - linexyz1[z]
	point[x] -= linexyz1[x]
	point[y] -= linexyz1[y]
	point[z] -= linexyz1[z]
	costheta = cos(theta)
	sintheta = sin(theta)
	q[x] += (costheta + (1 - costheta) * r[x] * r[x]) * point[x]
	q[x] += ((1 - costheta) * r[x] * r[y] - r[z] * sintheta) * point[y]
	q[x] += ((1 - costheta) * r[x] * r[z] + r[y] * sintheta) * point[z]
	q[y] += ((1 - costheta) * r[x] * r[y] + r[z] * sintheta) * point[x]
	q[y] += (costheta + (1 - costheta) * r[y] * r[y]) * point[y]
	q[y] += ((1 - costheta) * r[y] * r[z] - r[x] * sintheta) * point[z]
	q[z] += ((1 - costheta) * r[x] * r[z] - r[y] * sintheta) * point[x]
	q[z] += ((1 - costheta) * r[y] * r[z] + r[x] * sintheta) * point[y]
	q[z] += (costheta + (1 - costheta) * r[z] * r[z]) * point[z]
	q[x] += linexyz1[x]
	q[y] += linexyz1[y]
	q[z] += linexyz1[z]

	return tuple(q)

def rotate3D(vec, axis, amt):
	"""
	Rotates a vector about the origin on an arbitrary axis by
	some amount. Returns the rotated vector.
	ported from Steve Wismath's aribtrary axis rotation code,
	as seen in CPSC3710
	"""
	sin_t = sin(amt) #*pi/180.0)
	cos_t = cos(amt) #*pi/180.0)

	uX, uY, uZ = axis
	vX, vY, vZ = vec
	return (
		vX * (uX * uX + cos_t * (1.0 - uX*uX)) +
		vY * (uY * uX * (1.0 - cos_t) - uZ * sin_t) +
		vZ * (uZ * uX * (1.0 - cos_t) + uY * sin_t),

		vX * (uX * uY * (1.0 - cos_t) + uZ * sin_t) +
		vY * (uY * uY + cos_t * (1.0 - uY*uY)) +
		vZ * (uZ * uY * (1.0 - cos_t) - uX * sin_t),

		vX * (uX * uZ * (1.0 - cos_t) - uY * sin_t) +
		vY * (uY * uZ * (1.0 - cos_t) + uX * sin_t) +
		vZ * (uZ * uZ + cos_t * (1.0 - uZ*uZ))
	)

